#!/usr/bin/env bash
# 提交后：用本次 commit 标题 + 短 SHA 更新 Portal 角标，并同步 docs/
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
if [[ "${PORTAL_VERSION_HOOK:-}" == "1" ]]; then
  exit 0
fi
export PORTAL_VERSION_HOOK=1

MSG="$(git log -1 --pretty=%s)"
case "$MSG" in
  Merge\ *|Revert\ *|sync:\ portal\ version*|chore:\ portal\ version*) exit 0 ;;
esac

"$ROOT/scripts/sync-portal-build-version.sh" "$MSG" || {
  echo "portal-version: sync failed" >&2
  exit 0
}

if [[ -z "$(git -C "$ROOT" status --porcelain -- prototype/index.html docs/)" ]]; then
  exit 0
fi

git -C "$ROOT" add -- prototype/index.html docs/

if git -C "$ROOT" rev-parse @{u} >/dev/null 2>&1; then
  AHEAD="$(git -C "$ROOT" rev-list --count @{u}..HEAD 2>/dev/null || echo 0)"
else
  AHEAD=1
fi

if [[ "$AHEAD" -gt 0 ]]; then
  git -C "$ROOT" commit --amend --no-edit --no-verify -q
else
  git -C "$ROOT" commit --no-verify -q -m "sync: portal version ($MSG)"
fi
